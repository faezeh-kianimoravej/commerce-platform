# Copy this file to terraform.tfvars for non-secret local settings only.
# Do not put passwords, API keys, or other secrets in terraform.tfvars.

# subscription_id = "00000000-0000-0000-0000-000000000000"

resource_group_name = "rg-commerce-dev"
location            = "West Europe"
workload_location   = "North Europe"
environment         = "dev"

acr_name          = "acrcommerceplatformdev"
acr_sku           = "Basic"
acr_admin_enabled = false

log_analytics_workspace_name    = "workspacergcommercedev9827"
container_apps_environment_name = "managedEnvironment-rgcommercedev-a0e2"
container_apps_identity_name    = "id-commerce-containerapps-acrpull-dev"

prometheus_container_app_name = "commerce-prometheus-dev"
prometheus_image              = "prom/prometheus:latest"
prometheus_scrape_interval    = "15s"
prometheus_scrape_targets = {
  product = {
    service_key  = "product"
    job_name     = "commerce-product-service"
    metrics_path = "/actuator/prometheus"
  }
}

grafana_container_app_name          = "commerce-grafana-dev"
grafana_image                       = "grafana/grafana:latest"
grafana_admin_user                  = "admin"
grafana_prometheus_datasource_name  = "Prometheus"

# Supply the Grafana admin password with TF_VAR_grafana_admin_password.

# Set this to the actual existing PostgreSQL Flexible Server name before import/apply.
postgres_server_name    = "commerce-product-db-dev"
postgres_version        = "16"
postgres_admin_username = "commerceadmin"

# Optional least-privilege database users. Omit for simple dev use of postgres_admin_username.
database_usernames = {
  product = "commerceadmin"
  order   = "commerceadmin"
}

# Services are keyed by a stable Terraform identity such as product, order, or gateway.
# Change image_tag to the tag produced by service CI/CD.
services = {
  product = {
    app_name         = "commerce-product-service-dev"
    image_repository = "commerce-product-service"
    image_tag        = "dev"
    target_port      = 8080
    external_ingress = true
    database_name    = "product_db"
  }

  order = {
    app_name         = "commerce-order-service-dev"
    image_repository = "commerce-order-service"
    image_tag        = "dev"
    target_port      = 8080
    external_ingress = false
    database_name    = "order_db"
  }

  gateway = {
    app_name         = "commerce-api-gateway-dev"
    image_repository = "commerce-api-gateway"
    image_tag        = "dev"
    target_port      = 8080
    external_ingress = true
    database_name    = null
  }
}
