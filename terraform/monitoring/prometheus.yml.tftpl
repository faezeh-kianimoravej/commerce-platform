global:
  scrape_interval: ${scrape_interval}

scrape_configs:
%{ for scrape_job in scrape_jobs ~}
  - job_name: ${scrape_job.job_name}
    metrics_path: ${scrape_job.metrics_path}
    static_configs:
      - targets:
%{ for target_address in scrape_job.target_addresses ~}
          - ${target_address}
%{ endfor ~}
%{ endfor ~}
